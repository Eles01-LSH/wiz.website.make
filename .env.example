# NAVER Cloud Platform 콘솔 > Maps > Application 등록 후 발급받는 Client ID
# (구 "AI·NAVER API" 기반 지도가 아닌, 신규 Maps 서비스 기준입니다)
# 아래 두 서비스를 반드시 함께 활성화하세요.
#   - Web Dynamic Map   : 화면에 표시되는 인터랙티브 지도(드래그/줌/마커)
#   - Geocoding         : 주소를 좌표로 변환(정확한 회사 위치 표시)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 네이버 메일 SMTP — 문의 폼 제출 시 이메일 알림 발송용
# 1) 네이버 메일 접속 > 환경설정 > POP3/IMAP 설정 > "IMAP/SMTP 사용" 켜기
# 2) 2단계 인증을 쓰신다면 네이버ID > 보안설정에서 "애플리케이션 비밀번호" 발급 후 그 값을 사용
# 3) 아래 두 값을 채우세요 (NAVER_MAIL_USER는 "wizmedia" 또는 "wizmedia@naver.com" 둘 다 가능)
NAVER_MAIL_USER=
NAVER_MAIL_PASSWORD=

# Supabase — 사전등록 데이터 저장 + 관리자 인증(Auth)
# Supabase 대시보드 > Project Settings > API 에서 확인 가능.
# URL과 anon key는 브라우저에 노출되는 값이라 NEXT_PUBLIC_ 접두사를 붙여도 안전하다
# (실제 접근 제어는 Postgres RLS 정책이 담당한다 — supabase/schema.sql 참고).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key는 RLS를 완전히 우회하는 매우 민감한 키다.
# NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것 — 서버 전용 코드(src/lib/supabase/admin.ts)에서만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=
